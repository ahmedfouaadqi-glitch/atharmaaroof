# Public Supabase settings from one and the same ATHAR project.
# Preferred for new projects: NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY.
# Netlify's official Supabase integration for Next.js commonly sets NEXT_PUBLIC_SUPABASE_ANON_KEY.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Only this administrator email (or a comma-separated server-side allowlist) may use /control-center.
ATHAR_ADMIN_EMAILS=ahmedmaaroof814@gmail.com

# Optional OpenAI-compatible assistant provider. Keep these server-only (no NEXT_PUBLIC_ prefix).
# Leave unset to use the verified database-backed guided-search mode.
ATHAR_AI_CHAT_COMPLETIONS_URL=
ATHAR_AI_API_KEY=
ATHAR_AI_MODEL=

# Never add a Supabase secret/service_role key to NEXT_PUBLIC_* or commit real credentials.
